# MongoDB. Leave empty to use a local server on port 27017,
# or an embedded database that starts with `npm run dev`.
MONGODB_URI=
MONGODB_DB=impactmesh

# Cloudinary — optional. Uploads stay on this machine when these are empty.
# Never expose the API secret to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Jev AI routing via OpenRouter — optional structured decisions, not narrative text.
# A local policy makes the same decisions when the key is empty.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-router
# Legacy: TYPESAFE_API_KEY is used as fallback if OPENROUTER_API_KEY is empty.
TYPESAFE_API_KEY=

# Groq — optional, for fast LLM-powered features.
GROQ_API_KEY=

# Redis / BullMQ. Leave empty to run jobs inside the API process.
REDIS_URL=

# Application
API_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173
PORT=8787
SESSION_SECRET=replace-with-a-long-random-string
WORKER_SECRET=replace-with-a-worker-secret
NODE_ENV=development
